secret = 7 

for i in range(5):
    guess = int(input("Guess a number (1-15): "))
    diff = abs(guess - secret)
    
    if guess == secret:
        print("You win!")
        break
    elif diff <= 2:
        print("Close!")
    elif diff > 5:
        print("Too far!")
    elif guess > secret:
        print("Too high!")
    else:
        print("Too low!")
else:
    print("Game over! The number was:", secret)